# Server-only configuration. Never expose these through client-side variables.
HELION_DB_PATH=./data/helion.sqlite
RATE_LIMIT_SALT=replace-with-a-long-random-secret
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_SHEET_NAME=Interests
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Use escaped newlines in hosted environments.
GOOGLE_PRIVATE_KEY=

# Payments: configured only on the durable SQLite backend.
HELION_UPI_ID=hridayan.real@fam
HELION_UPI_PAYEE_NAME=HELION
HELION_EARLY_ACCESS_AMOUNT=19
# Generate a salted hash with: npm run admin:password
HELION_ADMIN_USERNAME=admin
HELION_ADMIN_PASSWORD_HASH=5360e36e89017405bb6a30802f5ed6a9:b0544863733dc0969d46bcd1db117618d764c9648c04bd16fd22cfd0c8aee9f8497fb1eca7b646c1cedf28902f5c9ff6401bea48118f72626151b1a5dcbf335d
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
# Public frontend origin, e.g. https://your-helion-site.vercel.app
HELION_PUBLIC_ORIGIN=
# Set true when serving HTTPS (also automatic with NODE_ENV=production).
HELION_COOKIE_SECURE=false
# Enable only behind a trusted proxy that replaces X-Forwarded-For.
HELION_TRUST_PROXY=false
# Vercel only: HTTPS origin of the persistent Node backend, never this frontend.
HELION_BACKEND_ORIGIN=
# Same long random secret on Vercel and the backend when using the proxy.
HELION_PROXY_SECRET=
